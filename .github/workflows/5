name: Content Pipeline
run-name: dl-${{ github.run_id }}

on:
  workflow_dispatch:
    inputs:
      mode:
        description: 'Operation Mode'
        required: true
        default: 'search'
        type: choice
        options:
          - 'search'
          - 'latest'
          - 'direct'
      query:
        description: 'Target query or URL'
        required: false
        default: 'Barcelona'
        type: string
      count:
        description: 'Item count'
        required: true
        default: '3'
        type: choice
        options:
          - '1'
          - '2'
          - '3'
          - '5'
      quality:
        description: 'Quality'
        required: true
        default: '1080'
        type: choice
        options:
          - '1080'
          - '720'
          - '480'
          - 'best'

permissions:
  contents: write

jobs:
  fetch-and-package:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - name: Free runner space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache || true

      - name: Set up Python tools
        run: |
          python -m pip install --quiet --upgrade pip
          python -m pip install --quiet --upgrade yt-dlp imageio-ffmpeg curl_cffi beautifulsoup4 requests
          if command -v ffmpeg >/dev/null 2>&1; then
            FFMPEG_BIN=$(command -v ffmpeg)
          else
            FFMPEG_BIN=$(python -c "import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())")
            chmod +x "$FFMPEG_BIN"
          fi
          echo "FFMPEG_BIN=$FFMPEG_BIN" >> "$GITHUB_ENV"

      - name: Resolve target links
        env:
          MODE: ${{ inputs.mode }}
          QUERY: ${{ inputs.query }}
          COUNT: ${{ inputs.count }}
        run: |
          python - <<'PY'
          import urllib.request, urllib.parse, re, os, sys
          from bs4 import BeautifulSoup

          mode = os.environ.get("MODE", "search")
          query = os.environ.get("QUERY", "").strip()
          count = int(os.environ.get("COUNT", "3"))

          targets = []
          headers = {
              "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
          }

          if mode == "direct":
              if query.startswith("http"):
                  targets.append(query)

          elif mode == "search":
              print(f"Searching index for: {query}")
              # Strategy 1: Search engine HTML extraction
              try:
                  q_enc = urllib.parse.quote(f"site:sport5.co.il OR site:one.co.il {query}")
                  search_url = f"https://html.duckduckgo.com/html/?q={q_enc}"
                  req = urllib.request.Request(search_url, headers=headers)
                  with urllib.request.urlopen(req, timeout=15) as resp:
                      soup = BeautifulSoup(resp.read(), "html.parser")
                      for a in soup.find_all("a", href=True):
                          href = a["href"]
                          if "uddg=" in href:
                              m = re.search(r"uddg=([^&]+)", href)
                              if m:
                                  actual = urllib.parse.unquote(m.group(1))
                                  if ("sport5.co.il/articles.aspx" in actual or "one.co.il/Article" in actual):
                                      if actual not in targets:
                                          targets.append(actual)
                                          if len(targets) >= count:
                                              break
              except Exception as e:
                  print(f"Search index error: {e}")

              # Strategy 2: Direct site scanning fallback
              if len(targets) < count:
                  for site in ["https://www.sport5.co.il/", "https://www.one.co.il/"]:
                      try:
                          req = urllib.request.Request(site, headers=headers)
                          with urllib.request.urlopen(req, timeout=15) as resp:
                              soup = BeautifulSoup(resp.read(), "html.parser")
                              for a in soup.find_all("a", href=True):
                                  h = a["href"]
                                  t = (a.get_text() or "").strip()
                                  full_link = ""
                                  if "articles.aspx" in h and "docID=" in h:
                                      full_link = h if h.startswith("http") else f"https://www.sport5.co.il/{h.lstrip('/')}"
                                  elif "/Article/" in h:
                                      full_link = h if h.startswith("http") else f"https://www.one.co.il/{h.lstrip('/')}"

                                  if full_link and full_link not in targets:
                                      if query.lower() in t.lower() or query.lower() in h.lower():
                                          targets.append(full_link)
                                          if len(targets) >= count:
                                              break
                      except Exception as e:
                          print(f"Direct scan error: {e}")

          elif mode == "latest":
              print("Fetching latest media links...")
              for site in ["https://www.sport5.co.il/", "https://www.one.co.il/"]:
                  try:
                      req = urllib.request.Request(site, headers=headers)
                      with urllib.request.urlopen(req, timeout=15) as resp:
                          soup = BeautifulSoup(resp.read(), "html.parser")
                          for a in soup.find_all("a", href=True):
                              h = a["href"]
                              full_link = ""
                              if "articles.aspx" in h and "docID=" in h:
                                  full_link = h if h.startswith("http") else f"https://www.sport5.co.il/{h.lstrip('/')}"
                              elif "/Article/" in h:
                                  full_link = h if h.startswith("http") else f"https://www.one.co.il/{h.lstrip('/')}"

                              if full_link and full_link not in targets:
                                  targets.append(full_link)
                                  if len(targets) >= count:
                                      break
                  except Exception as e:
                      print(f"Latest fetch error: {e}")

          clean_targets = targets[:count]
          with open("targets.txt", "w", encoding="utf-8") as f:
              for url in clean_targets:
                  f.write(url.strip() + "\n")

          print(f"Total resolved targets: {len(clean_targets)}")
          for u in clean_targets:
              print(f"-> {u}")
          PY
          sed -i 's/\r//g' targets.txt

      - name: Download target items
        env:
          QUALITY: ${{ inputs.quality }}
        run: |
          mkdir -p out

          case "$QUALITY" in
            1080) FMT_ARGS="-f bv*[height<=1080]+ba/b[height<=1080]/bv*+ba/b --merge-output-format mp4" ;;
            720)  FMT_ARGS="-f bv*[height<=720]+ba/b[height<=720]/bv*+ba/b --merge-output-format mp4" ;;
            480)  FMT_ARGS="-f bv*[height<=480]+ba/b[height<=480]/bv*+ba/b --merge-output-format mp4" ;;
            *)    FMT_ARGS="-f bv*+ba/b --merge-output-format mp4" ;;
          esac

          while IFS= read -r URL; do
            URL=$(echo "$URL" | tr -d '\r\n' | xargs)
            [ -z "$URL" ] && continue
            echo "Processing item: $URL"
            yt-dlp \
              $FMT_ARGS \
              --user-agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" \
              --no-playlist --no-progress --newline \
              --retries 5 --fragment-retries 10 \
              --embed-metadata \
              --ffmpeg-location "$FFMPEG_BIN" \
              -o "out/%(title).100B [%(id)s].%(ext)s" \
              -- "$URL" || echo "Item skipped on error"
          done < targets.txt

      - name: Package safe archives (max 1.8GB)
        run: |
          if [ -z "$(ls -A out 2>/dev/null)" ]; then
            echo "::error::No media files were generated."
            exit 1
          fi

          mkdir -p pack
          python - <<'PY'
          import os, re, sys, zipfile

          out_dir = "out"
          pack_dir = "pack"
          MAX_SIZE = int(1.8 * 1024 * 1024 * 1024)

          for root, _, fnames in os.walk(out_dir):
              for f in fnames:
                  full = os.path.join(root, f)
                  if os.path.getsize(full) > MAX_SIZE:
                      part = 1
                      chunks = []
                      with open(full, "rb") as src:
                          while True:
                              data = src.read(MAX_SIZE)
                              if not data:
                                  break
                              cpath = f"{full}.{part:03d}"
                              with open(cpath, "wb") as dst:
                                  dst.write(data)
                              chunks.append(cpath)
                              part += 1
                      os.remove(full)
                      bat_path = os.path.splitext(full)[0] + "_JOIN.bat"
                      parts_str = " + ".join([f'"{os.path.basename(c)}"' for c in chunks])
                      with open(bat_path, "w", encoding="utf-8") as bat:
                          bat.write(f'@echo off\ncopy /b {parts_str} "{f}"\necho Done!\npause\n')

          all_files = []
          for root, _, fnames in os.walk(out_dir):
              for f in fnames:
                  full = os.path.join(root, f)
                  rel = os.path.relpath(full, out_dir)
                  all_files.append((full, rel, os.path.getsize(full)))
          all_files.sort(key=lambda x: x[1])

          base_name = "collection"
          total_sz = sum(f[2] for f in all_files)
          if total_sz <= MAX_SIZE:
              zpath = os.path.join(pack_dir, f"{base_name}.zip")
              with zipfile.ZipFile(zpath, 'w', compression=zipfile.ZIP_STORED) as zf:
                  for full, rel, _ in all_files:
                      zf.write(full, rel)
          else:
              sub = 1
              cur_sz = 0
              zf = None
              for full, rel, sz in all_files:
                  if zf is None or (cur_sz + sz > MAX_SIZE and cur_sz > 0):
                      if zf:
                          zf.close()
                      zpath = os.path.join(pack_dir, f"{base_name}_part{sub:02d}.zip")
                      zf = zipfile.ZipFile(zpath, 'w', compression=zipfile.ZIP_STORED)
                      sub += 1
                      cur_sz = 0
                  zf.write(full, rel)
                  cur_sz += sz
              if zf:
                  zf.close()
          PY

      - name: Create release and upload
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          TAG: pkg-${{ github.run_id }}
        run: |
          gh release create "$TAG" --title "Package - ${{ github.run_id }}" --notes "Automated package - safe to delete"

          while IFS= read -r -d '' f; do
            esc=$(printf '%s' "$f" | sed 's/[][*?\\]/\\&/g')
            for attempt in 1 2 3 4 5; do
              echo "Uploading $f..."
              if gh release upload "$TAG" "$esc" --clobber; then
                echo "Upload successful."
                break
              fi
              sleep 5
            done
          done < <(find pack -name "*.zip" -type f -print0)

      - name: Summary report
        run: |
          echo "## Content Package Summary" >> "$GITHUB_STEP_SUMMARY"
          echo "| File | Size |" >> "$GITHUB_STEP_SUMMARY"
          echo "| :--- | :--- |" >> "$GITHUB_STEP_SUMMARY"
          for f in out/*; do
            if [ -f "$f" ]; then
              name=$(basename "$f")
              size=$(du -h "$f" | cut -f1)
              echo "| \`$name\` | $size |" >> "$GITHUB_STEP_SUMMARY"
            fi
          done
